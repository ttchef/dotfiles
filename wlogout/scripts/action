#!/usr/bin/bash

case $1 in
    shutdown)
        systemctl poweroff
        ;;
    reboot)
        systemctl reboot
        ;;
    logout)
        hyprshutdown
        ;;
    suspend)
        systemctl suspend
        ;;
    hibernate)
        systemctl hibernate
        ;;
    lock)
        hyprlock &
        ;;
    *)
        echo "error"
esac
